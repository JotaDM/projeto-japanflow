rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownLinkPath() {
      return /databases/$(database)/documents/auth_links/$(request.auth.uid);
    }

    function hasOwnLink() {
      return signedIn() && exists(ownLinkPath());
    }

    function ownLink() {
      return get(ownLinkPath()).data;
    }

    function isActive() {
      return hasOwnLink() && ownLink().active != false;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(ownLink().user_id);
    }

    function isTiMaster() {
      return isActive()
        && exists(currentUserPath())
        && ('sectors' in get(currentUserPath()).data)
        && get(currentUserPath()).data.sectors.hasAny(['ti']);
    }

    function isAdmin() {
      return isActive()
        && (ownLink().role == 'admin' || isTiMaster());
    }

    function currentUserId() {
      return ownLink().user_id;
    }

    match /auth_links/{uid} {
      allow read: if isActive()
        && (request.auth.uid == uid || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isActive();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isActive()
          && currentUserId() == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'avatar',
              'backgroundColor',
              'updated_at'
            ])
        );
    }

    match /user_feature_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /user_tab_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /task_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /app_settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /freight_destinations/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /system_notifications/{notificationId} {
      allow read: if isActive()
        && resource.data.recipient_user_id == currentUserId();

      allow update: if isActive()
        && resource.data.recipient_user_id == currentUserId()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read']);

      allow create, delete: if false;
    }

    match /system_runtime/{docId} {
      allow read: if isActive();
      allow create, update, delete: if false;
    }

    match /system_monitor_state/{docId} {
      allow read, write: if false;
    }

    // Mensagens privadas: acesso limitado aos participantes.
    match /messages/{messageId} {
      function participant(data) {
        return isActive()
          && (
            data.senderId == currentUserId()
            || data.receiverId == currentUserId()
          );
      }

      allow get: if participant(resource.data);

      allow list: if participant(resource.data)
        && request.query.limit <= 100;

      allow create: if isActive()
        && request.resource.data.senderId == currentUserId()
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != currentUserId()
        && request.resource.data.content is string;

      allow update: if participant(resource.data)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && (
          (
            resource.data.senderId == currentUserId()
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['content', 'edited', 'deleted'])
          )
          ||
          (
            resource.data.receiverId == currentUserId()
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['read'])
          )
        );

      allow delete: if false;
    }

    
    // GROUPS-4: autorização de grupos e mensagens.
    function groupPath(groupId) {
      return /databases/$(database)/documents/custom_groups/$(groupId);
    }

    function isGroupMember(groupId) {
      return isActive()
        && exists(groupPath(groupId))
        && currentUserId() in get(groupPath(groupId)).data.participant_ids;
    }

    function isGroupCreator(groupId) {
      return isGroupMember(groupId)
        && get(groupPath(groupId)).data.created_by == currentUserId();
    }

    match /custom_groups/{groupId} {
      allow get: if isGroupMember(groupId);

      allow list: if isActive()
        && currentUserId() in resource.data.participant_ids;

      allow create: if isActive()
        && request.resource.data.created_by == currentUserId()
        && request.resource.data.participant_ids is list
        && currentUserId() in request.resource.data.participant_ids
        && request.resource.data.participant_ids.size() > 0
        && request.resource.data.participant_ids.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Alterações de membros exigirão um fluxo administrativo próprio.
      allow update: if false;
      allow delete: if isGroupCreator(groupId);
    }

    match /group_messages/{messageId} {
      allow get: if isGroupMember(resource.data.group_id);

      allow list: if isGroupMember(resource.data.group_id)
        && request.query.limit <= 100;

      allow create: if isActive()
        && request.resource.data.group_id is string
        && isGroupMember(request.resource.data.group_id)
        && request.resource.data.sender_id == currentUserId()
        && request.resource.data.sender_username ==
          get(currentUserPath()).data.username
        && request.resource.data.content is string
        && request.resource.data.deleted == false
        && request.resource.data.edited == false;

      allow update: if isGroupMember(resource.data.group_id)
        && resource.data.sender_id == currentUserId()
        && resource.data.deleted == false
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['content', 'edited', 'deleted', 'updated_at'])
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.group_id == resource.data.group_id
        && request.resource.data.sender_username == resource.data.sender_username
        && (
          (
            request.resource.data.deleted == false
            && request.resource.data.edited == true
            && request.resource.data.content is string
          )
          ||
          (
            request.resource.data.deleted == true
            && request.resource.data.content == 'Mensagem apagada'
          )
        );

      allow delete: if false;
    }

    match /chat_read_status/{statusId} {
      allow get, list: if isActive()
        && resource.data.user_id == currentUserId()
        && request.query.limit <= 100;

      allow create: if isActive()
        && request.resource.data.user_id == currentUserId()
        && request.resource.data.group_id is string
        && isGroupMember(request.resource.data.group_id);

      allow update: if isActive()
        && resource.data.user_id == currentUserId()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.group_id == resource.data.group_id
        && isGroupMember(resource.data.group_id)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['last_read_at', 'updated_at']);

      allow delete: if false;
    }

    // Demais coleções operacionais do JapanFlow.
    match /{collection}/{document=**} {
      allow read, write: if isActive()
        && collection != 'users'
        && collection != 'auth_links'
        && collection != 'user_feature_permissions'
        && collection != 'user_tab_permissions'
        && collection != 'task_permissions'
        && collection != 'app_settings'
        && collection != 'custom_groups'
        && collection != 'group_messages'
        && collection != 'chat_read_status'
        && collection != 'freight_destinations'
        && collection != 'system_notifications'
        && collection != 'system_runtime'
        && collection != 'system_monitor_state'
        && collection != 'messages';
    }
  }
}
